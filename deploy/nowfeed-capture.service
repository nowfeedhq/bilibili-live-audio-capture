[Unit]
Description=NowFeed Bilibili Audio Capture
After=network.target

[Service]
User=nowfeed-capture
Group=nowfeed-capture
WorkingDirectory=/opt/nowfeed-capture
ExecStart=/opt/nowfeed-capture/.venv/bin/python -m server.app --config /opt/nowfeed-capture/server/config.json
Restart=on-failure
RestartSec=5
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/nowfeed-capture

[Install]
WantedBy=multi-user.target
